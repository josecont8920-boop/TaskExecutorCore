# --- Integracion con n8n (Servidor 1, externo) ---
# Secreto compartido: n8n debe enviarlo en el header X-Webhook-Secret
N8N_WEBHOOK_SECRET=

# --- Motor de IA y voz (Servidor 2 - Railway) ---
# Este servicio usa EXCLUSIVAMENTE estas 3 variables para IA/voz.
# No hay base de datos ni otra integracion externa.
GEMINI_API_KEY=
GOOGLE_TTS_API_KEY=
# Contenido COMPLETO del JSON de la cuenta de servicio de Google Cloud
# (motor de voz), pegado tal cual como valor de una sola linea.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- App ---
LOG_LEVEL=INFO
